// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum LeadStatus {
  DISCOVERED
  VALIDATED
  RESEARCHING
  QUALIFIED
  NO_OPPORTUNITY
  OUTREACH_READY
  DRAFTED
  APPROVED
  SENT
  OPENED
  REPLIED
  POSITIVE_REPLY
  NEGATIVE_REPLY
  MEETING
  PROPOSAL
  WON
  LOST
}

enum OpportunityStatus {
  NO_OPPORTUNITY
  POTENTIAL
  QUALIFIED
  STRONG_OPPORTUNITY
}

enum EvidenceLevel {
  DIRECT
  INFERRED
  WEAK
  UNVERIFIED
}

enum OutreachChannel {
  EMAIL
  LINKEDIN
  WHATSAPP
  CALL
}

enum OutreachStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
  OPENED
  REPLIED
}

enum BudgetState {
  NORMAL
  CAUTION
  RESTRICTED
  MINIMAL
  STOP
}

enum AIProvider {
  DEEPSEEK
  JEV
  MOCK
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  DEAD
}

enum ResearchDepth {
  SHALLOW
  STANDARD
  DEEP
}

enum SignalType {
  NEW_LOCATION
  EXPANSION
  HIRING
  NEW_SERVICE
  NEW_PRODUCT
  FUNDING
  REBRANDING
  NEW_LEADERSHIP
  NEW_OFFICE
  INCREASED_REVIEWS
  ACTIVE_ADVERTISING
  TECHNOLOGY_CHANGE
  MAJOR_LAUNCH
  NEW_WEBSITE
  NEW_PARTNERSHIP
  NEW_MARKET
  OTHER
}

enum CapabilityCategory {
  TECHNOLOGY
  GROWTH
  CREATIVE
  BUSINESS_INFRASTRUCTURE
  EDUCATION_COMMUNITY
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

// ============================================================
// CAMPAIGN
// ============================================================

model Campaign {
  id          String         @id @default(cuid())
  name        String
  description String?
  status      CampaignStatus @default(DRAFT)

  // Natural language original input
  naturalLanguageInput String?

  // Structured configuration (stored as JSON)
  config Json

  // Budget
  budgetLimitINR Float?
  spentINR       Float  @default(0)

  // Targets
  targetLeadCount Int?
  maxLeadCount    Int?

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime?
  completedAt DateTime?

  // Relations
  leads     Lead[]
  jobs      PipelineJob[]
  aiUsage   AIUsageLog[]

  @@index([status])
  @@index([createdAt])
}

// ============================================================
// COMPANY (persistent entity across campaigns)
// ============================================================

model Company {
  id              String  @id @default(cuid())
  canonicalDomain String? @unique
  primaryName     String
  aliases         String[] // alternative names
  domains         String[] // all known domains
  phones          String[] // all known phones
  emails          String[] // all known emails
  sourceIds       Json     @default("{}") // {sourceId: sourceType}

  // Location
  address  String?
  city     String?
  state    String?
  country  String?
  pincode  String?
  lat      Float?
  lng      Float?

  // Classification
  industry    String?
  subIndustry String?
  companyType String? // local, B2B, startup, SMB, enterprise, etc.
  employeeMin Int?
  employeeMax Int?

  // Contact
  primaryPhone   String?
  primaryEmail   String?
  primaryWebsite String?

  // Social
  linkedinUrl   String?
  facebookUrl   String?
  instagramUrl  String?
  twitterUrl    String?
  youtubeUrl    String?
  whatsappPhone String?

  // Memory
  firstDiscoveredAt DateTime  @default(now())
  lastResearchedAt  DateTime?
  lastOutreachAt    DateTime?

  // Status tracking
  currentStatus LeadStatus @default(DISCOVERED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  leads        Lead[]
  contacts     Contact[]
  websiteAudits WebsiteAudit[]
  opportunities Opportunity[]
  buyingSignals BuyingSignal[]
  competitors   CompetitorResearch[]
  outreachItems Outreach[]
  evidenceItems Evidence[]
  researchReports ResearchReport[]
  pipelineSteps   PipelineStep[]

  @@index([canonicalDomain])
  @@index([primaryName])
  @@index([city, country])
  @@index([currentStatus])
}

// ============================================================
// RAW LEAD (source record — never mutate)
// ============================================================

model Lead {
  id         String     @id @default(cuid())
  status     LeadStatus @default(DISCOVERED)

  // Source provenance
  source     String // connector id
  sourceId   String? // id in source system
  sourceUrl  String?

  // Raw fields from source
  companyName  String
  website      String?
  phone        String?
  email        String?
  address      String?
  city         String?
  state        String?
  country      String?
  industry     String?
  description  String?
  socialLinks  Json?
  rawData      Json? // full original source payload

  // Normalized fields (computed after normalization)
  normalizedDomain String?
  normalizedPhone  String?
  normalizedEmail  String?

  // Deduplication
  isDuplicate   Boolean @default(false)
  duplicateOfId String?
  duplicateOf   Lead?   @relation("LeadDuplicates", fields: [duplicateOfId], references: [id])
  duplicates    Lead[]  @relation("LeadDuplicates")

  // Linked company (after dedup + merge)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  // Campaign
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id])

  // Qualification
  opportunityScore    Float?
  evidenceConfidence  Float?
  opportunityStatus   OpportunityStatus?
  qualificationReason String?

  // Timestamps
  discoveredAt DateTime  @default(now())
  validatedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  pipelineSteps PipelineStep[]
  aiUsage       AIUsageLog[]

  @@unique([source, sourceId])
  @@index([status])
  @@index([companyId])
  @@index([campaignId])
  @@index([normalizedDomain])
  @@index([isDuplicate])
}

// ============================================================
// CONTACT (decision makers)
// ============================================================

model Contact {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  name       String
  role       String?
  department String?

  // Contact channels
  email     String?
  phone     String?
  linkedin  String?
  whatsapp  String?

  // Confidence & verification
  confidence Float   @default(0)
  verified   Boolean @default(false)
  sources    Json    @default("[]") // [{url, type, retrievedAt}]

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outreachItems Outreach[]

  @@index([companyId])
}

// ============================================================
// WEBSITE AUDIT (deterministic checks)
// ============================================================

model WebsiteAudit {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  url          String
  finalUrl     String? // after redirects
  httpStatus   Int?
  httpsEnabled Boolean?
  sslValid     Boolean?
  loadTimeMs   Int?

  // Structure
  hasTitle           Boolean?
  title              String?
  hasMetaDescription Boolean?
  metaDescription    String?
  hasH1              Boolean?
  h1Text             String?
  hasCanonical       Boolean?
  hasRobots          Boolean?
  hasSitemap         Boolean?
  hasFavicon         Boolean?

  // Content
  hasContactPage  Boolean?
  hasContactForm  Boolean?
  hasPhone        Boolean?
  hasEmail        Boolean?
  hasWhatsApp     Boolean?
  hasBookingLink  Boolean?
  hasCTA          Boolean?
  hasBlog         Boolean?
  hasPortfolio    Boolean?
  hasPricing      Boolean?
  hasCareers      Boolean?
  hasSocialLinks  Boolean?

  // Tech detection
  hasAnalytics     Boolean?
  analyticsType    String?
  cms              String?
  framework        String?
  technologies     String[]

  // Mobile
  hasMobileViewport Boolean?

  // SEO
  hasStructuredData Boolean?
  structuredDataTypes String[]
  brokenLinksCount  Int?

  // Quality indicators
  pageWordCount   Int?
  imageCount      Int?
  hasAltText      Boolean?

  // Raw content (cleaned, for AI)
  extractedText   String?
  extractedLinks  Json?
  screenshotPath  String?

  // Fetch metadata
  fetchError    String?
  usedHeadless  Boolean @default(false)
  usedJina      Boolean @default(false)
  rawHtmlSize   Int?
  cleanedSize   Int?

  auditedAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([auditedAt])
}

// ============================================================
// EVIDENCE
// ============================================================

model Evidence {
  id        String @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])

  level       EvidenceLevel
  claim       String
  sourceUrl   String?
  sourceType  String? // website, search, screenshot, manual
  evidenceText String? // verbatim source snippet
  retrievedAt DateTime @default(now())

  // Screenshot evidence
  screenshotPath String?
  capturedAt     DateTime?

  // Search result evidence
  searchQuery    String?
  resultTitle    String?

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([opportunityId])
  @@index([level])
}

// ============================================================
// CAPABILITY LIBRARY
// ============================================================

model Capability {
  id       String             @id @default(cuid())
  name     String             @unique
  category CapabilityCategory
  enabled  Boolean            @default(true)

  description         String
  idealCustomers      String? // prose description
  positiveSignals     String[] // signal keywords
  negativeSignals     String[] // disqualifying signals
  evidenceRequirements String[] // what evidence is needed
  relatedCapabilityIds String[]
  pitchAngles         String[] // approved messaging angles
  prohibitedClaims    String[] // things we must NEVER say

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunities Opportunity[]

  @@index([category])
  @@index([enabled])
}

// ============================================================
// OPPORTUNITY
// ============================================================

model Opportunity {
  id        String @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  capabilityId String?
  capability   Capability? @relation(fields: [capabilityId], references: [id])

  status   OpportunityStatus
  priority String            @default("primary") // primary | secondary

  problem       String
  rationale     String?
  businessImpact String?
  confidence    Float
  evidenceUrls  String[]

  // Scoring breakdown
  opportunityStrength  Float @default(0)
  evidenceQuality      Float @default(0)
  brandexFit           Float @default(0)
  buyingSignalScore    Float @default(0)
  decisionMakerScore   Float @default(0)
  contactabilityScore  Float @default(0)
  totalScore           Float @default(0)
  researchConfidence   Float @default(0)

  scoreExplanation String?

  // Campaign context
  campaignId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evidence  Evidence[]
  outreach  Outreach[]

  @@index([companyId])
  @@index([status])
  @@index([totalScore])
}

// ============================================================
// BUYING SIGNAL
// ============================================================

model BuyingSignal {
  id        String @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  signalType  SignalType
  title       String
  description String?
  date        DateTime?
  sourceUrl   String?
  sourceType  String?
  evidenceText String?
  confidence  Float

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([signalType])
  @@index([date])
}

// ============================================================
// COMPETITOR RESEARCH
// ============================================================

model CompetitorResearch {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  competitorName    String
  competitorUrl     String?
  relevantFeature   String?
  prospectDifference String?
  evidence          String?
  useInOutreach     Boolean @default(false)

  researchedAt DateTime @default(now())

  @@index([companyId])
}

// ============================================================
// RESEARCH REPORT (human-readable summary)
// ============================================================

model ResearchReport {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  version       Int      @default(1)
  summary       String   // human-readable markdown
  rawAIOutput   Json?    // structured AI output (validated)
  researchDepth ResearchDepth @default(STANDARD)

  // What changed since last version
  changesSince  String?

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([createdAt])
}

// ============================================================
// OUTREACH
// ============================================================

model Outreach {
  id        String @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])

  channel OutreachChannel
  status  OutreachStatus  @default(DRAFT)

  // Content versions
  aiDraft       String // original AI draft
  editedVersion String? // human-edited version
  approvedVersion String? // final approved text
  subject       String? // for email

  // Personalization metadata
  personalizationLevel String? // standard | high_value | strategic
  outreachAngle        String?
  evidenceUsed         Json?   // which evidence items were used

  // Human approval
  approvedById  String?
  approvedAt    DateTime?
  rejectedReason String?

  // Sending
  sentAt    DateTime?
  sentVia   String? // provider used
  messageId String? // provider message ID

  // Outcome tracking
  openedAt    DateTime?
  repliedAt   DateTime?
  replyContent String?
  outcome      LeadStatus?
  outcomeAt    DateTime?

  campaignId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([channel])
  @@index([campaignId])
}

// ============================================================
// PIPELINE STEP (observability)
// ============================================================

model PipelineStep {
  id     String @id @default(cuid())
  leadId String?
  lead   Lead?  @relation(fields: [leadId], references: [id])

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  campaignId String?

  stepName    String
  status      JobStatus @default(PENDING)
  durationMs  Int?
  costINR     Float?
  provider    String?
  model       String?
  error       String?
  retryCount  Int       @default(0)
  evidenceCount Int?

  inputHash   String? // for dedup / caching
  outputRef   String? // reference to stored output

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([leadId])
  @@index([companyId])
  @@index([stepName])
  @@index([status])
  @@index([createdAt])
}

// ============================================================
// AI USAGE LOG (budget tracking)
// ============================================================

model AIUsageLog {
  id       String @id @default(cuid())
  provider AIProvider
  model    String

  inputTokens       Int
  cachedInputTokens Int   @default(0)
  outputTokens      Int
  estimatedCostUSD  Float
  estimatedCostINR  Float

  requestType String // company_understanding | website_analysis | etc.

  leadId     String?
  lead       Lead?   @relation(fields: [leadId], references: [id])
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id])

  // Budget state at time of request
  budgetStateAtRequest BudgetState @default(NORMAL)

  timestamp DateTime @default(now())

  @@index([provider])
  @@index([timestamp])
  @@index([campaignId])
  @@index([requestType])
}

// ============================================================
// LEARNING DATA (outcome tracking for analytics)
// ============================================================

model OutcomeRecord {
  id String @id @default(cuid())

  // Context
  industry         String?
  companySize      String?
  location         String?
  source           String?
  opportunityType  String?
  capabilityId     String?
  decisionMakerRole String?
  buyingSignalType String?
  outreachChannel  OutreachChannel?
  outreachAngle    String?
  personalizationLevel String?
  messageVariant   String?

  // Outcome
  outcome   LeadStatus
  outcomeAt DateTime @default(now())

  // Journey
  daysFromDiscoveryToOutreach Int?
  daysFromOutreachToOutcome   Int?

  campaignId String?

  createdAt DateTime @default(now())

  @@index([outcome])
  @@index([capabilityId])
  @@index([source])
  @@index([outcomeAt])
}

// ============================================================
// USER (auth)
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  role          String    @default("user") // user | admin
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  @@index([email])
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   // CREATE | UPDATE | DELETE | APPROVE | SEND | etc.
  resource  String   // model name
  resourceId String?
  before    Json?
  after     Json?
  ip        String?
  userAgent String?
  timestamp DateTime @default(now())

  @@index([userId])
  @@index([resource, resourceId])
  @@index([timestamp])
}

// ============================================================
// PIPELINE JOB (pg-boss job tracking)
// ============================================================

model PipelineJob {
  id         String   @id @default(cuid())
  jobId      String   @unique  // pg-boss job ID
  jobName    String            // queue name / job type
  campaignId String?
  companyId  String?
  leadId     String?
  status     String   @default("created") // created | active | completed | failed | expired
  input      Json
  output     Json?
  error      String?
  priority   Int      @default(0)
  retryCount Int      @default(0)
  maxRetries Int      @default(3)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  startedAt  DateTime?
  completedAt DateTime?

  campaign Campaign? @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
  @@index([companyId])
  @@index([jobName])
  @@index([status])
}
